# ─────────────────────────────────────────────────────────────────────────────
# SaharaFund Backend — Environment Configuration
# Copy this file to server/.env and fill in real values.
# NEVER commit server/.env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/saharafund?retryWrites=true&w=majority

# ── Authentication (JWT) ──────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_here
JWT_REFRESH_EXPIRES_IN=30d

# ── File Uploads ──────────────────────────────────────────────────────────────
UPLOAD_PATH=uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,image/gif,application/pdf

# ── Email (Nodemailer) ────────────────────────────────────────────────────────
EMAIL_FROM=noreply@saharafund.in
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# ── Payment Gateway — Razorpay ────────────────────────────────────────────────
# Get these from https://dashboard.razorpay.com/app/keys
# Use TEST keys (rzp_test_*) during development.
# Use LIVE keys (rzp_live_*) only in production with real KYC.
RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_KEY_SECRET

# Webhook secret — set in Razorpay Dashboard > Webhooks
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET

# Set to 'test' for sandbox/mock, 'live' for production
PAYMENT_MODE=test

# ── Bank Account Encryption ───────────────────────────────────────────────────
# 64-character hex string (32 bytes) for AES-256 encryption of account numbers.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If not set, account numbers are stored with a development mask only.
BANK_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# For client/.env — only VITE_* variables are exposed to the browser
# VITE_API_URL=https://your-backend.railway.app/api
# VITE_RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_KEY_ID  ← PUBLIC key only

# ── Deployment Notes ──────────────────────────────────────────────────────────
# Backend (Railway / Render):
#   1. Set all variables above as environment variables in the dashboard.
#   2. Set CLIENT_URL to your Netlify frontend URL.
#   3. Add your Render/Railway URL to Razorpay webhook URLs.
#
# Frontend (Netlify):
#   1. Set VITE_API_URL to your backend API URL.
#   2. Set VITE_RAZORPAY_KEY_ID to your PUBLIC Razorpay key (rzp_test_ or rzp_live_).
#   3. NEVER put RAZORPAY_KEY_SECRET in Netlify env vars.
