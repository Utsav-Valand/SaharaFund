# ==========================================
# SaharaFund Server Environment Configuration
# ==========================================

# Port & Environment
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
# Format: mongodb+srv://<username>:<password>@<cluster-address>/saharafund?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/saharafund?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=30d

# Client URLs (CORS)
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# File Uploads
UPLOAD_PATH=uploads
MAX_FILE_SIZE=10485760

# Email (SMTP Mock/Live)
EMAIL_FROM=noreply@saharafund.org
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
